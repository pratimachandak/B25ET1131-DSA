#include <stdio.h> 
#include <string.h> 
struct Student 
{ 
 int roll; 
 char name[20]; 
 float marks; 
}; 
struct Student s[50]; 
int n = 0; 
void create() 
{ 
 int i; 
 printf("Enter number of students: "); 
 scanf("%d", &n); 
 for (i = 0; i < n; i++) 
 { 
 printf("\nEnter Roll No: "); 
 scanf("%d", &s[i].roll); 
 printf("Enter Name: "); 
 scanf("%s", s[i].name); 
 printf("Enter Marks: "); 
 scanf("%f", &s[i].marks); 
 } 
}
void display() 
{ 
 int i; 
 printf("\nRoll\tName\tMarks\n"); 
 for (i = 0; i < n; i++) 
 { 
 printf("%d\t%s\t%.2f\n", 
 s[i].roll, s[i].name, s[i].marks);  } 
} 
void search() 
{ 
 int roll, i; 
 printf("Enter Roll No to search: ");  scanf("%d", &roll); 
 for (i = 0; i < n; i++) 
 { 
 if (s[i].roll == roll) 
 { 
 printf("Found: %d %s %.2f\n",  s[i].roll, s[i].name, s[i].marks);  return; 
 } 
 } 
 printf("Student not found\n"); } 
void modify() 
{ 
 int roll, i; 
 printf("Enter Roll No to modify: ");  scanf("%d", &roll);
 for (i = 0; i < n; i++) 
 { 
 if (s[i].roll == roll) 
 { 
 printf("Enter new name: ");  scanf("%s", s[i].name); 
 printf("Enter new marks: ");  scanf("%f", &s[i].marks); 
 printf("Record modified\n");  return; 
 } 
 } 
 printf("Student not found\n"); } 
void sort() 
{ 
 int i, j; 
 struct Student temp; 
 for (i = 0; i < n - 1; i++) 
 { 
 for (j = i + 1; j < n; j++)  { 
 if (s[i].roll > s[j].roll)  { 
 temp = s[i]; 
 s[i] = s[j]; 
 s[j] = temp; 
 } 
 } 
 } 
 printf("Records sorted\n"); }
int main() 
{ 
 int choice; 
 while (1) 
 { 
 printf("\n1. Create"); 
 printf("\n2. Display"); 
 printf("\n3. Modify"); 
 printf("\n4. Search"); 
 printf("\n5. Sort"); 
 printf("\n6. Exit"); 
 printf("\nEnter choice: "); 
 scanf("%d", &choice); 
 switch (choice) 
 { 
 case 1: create(); break; 
 case 2: display(); break;  case 3: modify(); break;  case 4: search(); break; 
 case 5: sort(); break; 
 case 6: return 0; 
 default: printf("Invalid choice\n");  } 
 } 
}
